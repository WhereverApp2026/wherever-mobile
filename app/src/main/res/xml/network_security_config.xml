<?xml version="1.0" encoding="utf-8"?>
<!-- Constitución §6: solo HTTPS y solo las CA del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
